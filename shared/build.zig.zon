.{
    // Protocol and crypto code shared by every Portal program: the server
    // (Portal's root build), the native client (../client, which builds on
    // its own too), the browser client (wasm32-freestanding) and the e2e
    // tests. Pure Zig over std; no dependencies.
    .name = .portal_shared,
    .version = "0.1.0",
    .minimum_zig_version = "0.18.0-dev.4+5a23bf4b2",
    .fingerprint = 0xd25ebfa7ac0ea9e,
    .dependencies = .{},
    .paths = .{ "build.zig", "build.zig.zon", "root.zig", "screen.zig" },
}
