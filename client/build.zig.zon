.{
    .name = .portal_client,
    .version = "0.1.0",
    .minimum_zig_version = "0.18.0-dev.4+5a23bf4b2",
    .fingerprint = 0xd9ed1b14d35f6f61,
    .dependencies = .{
        // The owner's Renderer (branch portal-client). Once merged into the
        // main Renderer checkout, change this to "../../Renderer".
        .Renderer = .{ .path = "../../Renderer-wt-portal" },
        // The owner's Image package (PNG decoder), PINNED by the owner's
        // request to Image@065e8ec (a detached worktree, used read-only).
        .Image = .{ .path = "../../Image-wt-portal" },
        // Portal's shared protocol code (../shared/root.zig), also used by
        // the server and the browser client.
        .shared = .{ .path = "../shared" },
    },
    .paths = .{ "build.zig", "build.zig.zon", "src", "tools", "README.md" },
}
