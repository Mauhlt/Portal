.{
    .name = .portal_client,
    .version = "0.1.0",
    .minimum_zig_version = "0.18.0-dev.4+5a23bf4b2",
    .fingerprint = 0xd9ed1b14d35f6f61,
    .dependencies = .{
        // The owner's Renderer (Font, Window, Instanced2D): the de-facto
        // checkout, no worktree, no pin.
        .Renderer = .{ .path = "../../Renderer-wt-ios" }, // TEMPORARY (feat/ios-native): back to ../../Renderer once ios-window is merged
        // The owner's Image package (Image.check + PNG decoder): the de-facto
        // checkout, no pin.
        .Image = .{ .path = "../../Image" },
        // Portal's shared protocol code (../shared/root.zig), also used by
        // the server and the browser client.
        .shared = .{ .path = "../shared" },
    },
    .paths = .{ "build.zig", "build.zig.zon", "src", "tools", "README.md" },
}
