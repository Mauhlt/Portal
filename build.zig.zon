.{
    .name = .Portal,
    .version = "0.0.1",
    .minimum_zig_version = "0.18.0-dev.4+5a23bf4b2",
    .paths = .{""},
    .fingerprint = 0xc0296c6a8828e98,
    .dependencies = .{
        // The owner's Renderer (Vulkan), used by the shared view module
        // (client/src/view) for `portal run`'s window and `portal connect`.
        // The de-facto Renderer: the owner's main checkout next to this repo,
        // no worktree, no pin.
        .Renderer = .{ .path = "../Renderer" },
        // The owner's Image package: Image.check validates inline images
        // (server and every client, client/src/image/imgcheck.zig) and its
        // PNG decoder decodes them (client/src/image/imgdec.zig). Its own
        // Vulkan dependency is ../Vulkan. The de-facto Image: the owner's
        // checkout as it stands (no pin; a break is fixed once, in Image).
        .Image = .{ .path = "../Image" },
        // Protocol and crypto code shared by the server, both clients and
        // the e2e tests (shared/root.zig; client/ depends on it too).
        .shared = .{ .path = "shared" },
        // The owner's pure-Zig WireGuard: the iPhone app's packet tunnel
        // extension (client/src/ios/tunnel_ext) runs it. Only iOS builds
        // and the extension's host tests compile it.
        .WireGuard = .{ .path = "../WireGuard" },
        // The owner's speech-to-text (read-only): stt.Home runs in-process
        // on the desktop GPU (src/speech/home.zig); its stt-local program
        // is the laptop's engine. stt brings ../Audio (the WAV Portal hands
        // it is encoded there) and ../TranslateNPU.
        .stt = .{ .path = "../SpeechToText" },
    },
}
