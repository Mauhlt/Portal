.{
    .name = .Portal,
    .version = "0.0.1",
    .minimum_zig_version = "0.18.0-dev.4+5a23bf4b2",
    .paths = .{""},
    .fingerprint = 0xc0296c6a8828e98,
    .dependencies = .{
        // The owner's Renderer (Vulkan), used by the shared view module
        // (client/src/view) for `portal run`'s window and `portal connect`.
        // Branch portal-client in a worktree for now; once the owner merges
        // that branch, change this to "../Renderer".
        .Renderer = .{ .path = "../Renderer-wt-portal" },
        // The owner's Image package: Image.check validates inline images
        // (server and every client, client/src/image/imgcheck.zig) and its
        // PNG decoder decodes them (client/src/image/imgdec.zig). Its own
        // Vulkan dependency is ../Vulkan. The de-facto Image: the owner's
        // checkout as it stands (no pin; a break is fixed once, in Image).
        .Image = .{ .path = "../Image" },
        // Protocol and crypto code shared by the server, both clients and
        // the e2e tests (shared/root.zig; client/ depends on it too).
        .shared = .{ .path = "shared" },
    },
}
